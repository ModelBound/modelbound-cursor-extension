{
  "name": "modelbound",
  "displayName": "ModelBound",
  "description": "Token optimization, Skill Development Pipeline, versions, restore, diff, and benchmark for agent-skill files — inline in Cursor & VS Code.",
  "version": "0.3.0",
  "publisher": "modelbound",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": { "vscode": "^1.84.0" },
  "categories": ["Other", "AI", "Linters"],
  "keywords": ["modelbound", "agent-skills", "token-optimization", "skill-pipeline", "cursor"],
  "repository": { "type": "git", "url": "https://github.com/ModelBound/modelbound-cursor-extension.git" },
  "homepage": "https://modelbound.co/open-source",
  "bugs": { "url": "https://github.com/ModelBound/modelbound-cursor-extension/issues" },
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "ModelBound",
      "properties": {
        "modelbound.apiUrl": {
          "type": "string",
          "default": "https://modelbound.co",
          "description": "ModelBound API base URL."
        },
        "modelbound.skillGlobs": {
          "type": "array",
          "default": ["**/skills/**/*.md", "**/.cursor/skills/**/*.md", "**/.agents/skills/**/*.md", "**/SKILL.md"],
          "description": "Glob patterns identifying skill files for CodeLens + status bar."
        },
        "modelbound.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Optimize / Pipeline / Versions CodeLens above skill files."
        },
        "modelbound.undoToastSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "description": "How long the undo toast stays open after an optimize/restore."
        }
      }
    },
    "commands": [
      { "command": "modelbound.login", "title": "ModelBound: Login" },
      { "command": "modelbound.logout", "title": "ModelBound: Logout" },
      { "command": "modelbound.whoami", "title": "ModelBound: Who am I" },
      { "command": "modelbound.optimize", "title": "ModelBound: Optimize current skill" },
      { "command": "modelbound.pipeline", "title": "ModelBound: Run Skill Development Pipeline" },
      { "command": "modelbound.test", "title": "ModelBound: Run skill test suite" },
      { "command": "modelbound.benchmark", "title": "ModelBound: Benchmark two versions" },
      { "command": "modelbound.versions", "title": "ModelBound: Show versions" },
      { "command": "modelbound.restore", "title": "ModelBound: Restore version…" },
      { "command": "modelbound.diff", "title": "ModelBound: Diff versions…" },
      { "command": "modelbound.health", "title": "ModelBound: Health check" }
    ],
    "menus": {
      "editor/title": [
        { "command": "modelbound.optimize", "when": "modelbound.isSkillFile", "group": "navigation@1" },
        { "command": "modelbound.versions", "when": "modelbound.isSkillFile", "group": "navigation@2" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.1.0",
    "typescript": "^5.5.0"
  }
}
