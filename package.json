{
  "name": "modelbound-cursor-extension",
  "displayName": "ModelBound \u2014 AI Context, Skills & MCP Sync for Cursor",
  "icon": "logo_modelbound.png",
  "description": "Cursor rules sync, .cursorrules manager, and system prompt version control. Sync AI skills, rules, and knowledge bases between your IDE and ModelBound.co via MCP. Works with Cursor, Claude Code, Kiro, and Copilot.",
  "version": "1.9.0",
  "publisher": "ModelBound",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": { "vscode": "^1.84.0" },
  "categories": ["Other", "AI", "Linters"],
  "keywords": ["modelbound", "agent-skills", "token-optimization", "skill-pipeline", "cursor"],
  "repository": { "type": "git", "url": "https://github.com/ModelBound/modelbound-cursor-extension.git" },
  "homepage": "https://modelbound.co/open-source",
  "bugs": { "url": "https://github.com/ModelBound/modelbound-cursor-extension/issues" },
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "configuration": {
      "title": "ModelBound",
      "properties": {
        "modelbound.apiUrl": {
          "type": "string",
          "default": "https://modelbound.co",
          "description": "ModelBound API base URL."
        },
        "modelbound.skillGlobs": {
          "type": "array",
          "default": ["**/skills/**/*.md", "**/.cursor/skills/**/*.md", "**/.agents/skills/**/*.md", "**/SKILL.md"],
          "description": "Glob patterns identifying skill files for CodeLens + status bar."
        },
        "modelbound.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Optimize / Pipeline / Versions CodeLens above skill files."
        },
        "modelbound.undoToastSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "description": "How long the undo toast stays open after an optimize/restore."
        }
      }
    },
    "commands": [
      {
        "command": "modelbound.signIn",
        "title": "ModelBound: Sign In with Browser"
      },
      {
        "command": "modelbound.signOut",
        "title": "ModelBound: Sign Out"
      },
      {
        "command": "modelbound.pullSkill",
        "title": "ModelBound: Pull Skill/Context to Local Workspace"
      },
      {
        "command": "modelbound.setApiKey",
        "title": "ModelBound: Set API Key (Manual)"
      },
      {
        "command": "modelbound.runSkillPipeline",
        "title": "ModelBound: Run Skill Development Pipeline"
      },
      {
        "command": "modelbound.browseResourceTree",
        "title": "ModelBound: Browse Resource Tree"
      },
      {
        "command": "modelbound.filterSkills",
        "title": "ModelBound: Filter Skills\u2026"
      },
      {
        "command": "modelbound.runSkillTest",
        "title": "ModelBound: Run Skill Test"
      },
      {
        "command": "modelbound.showSkillVersions",
        "title": "ModelBound: Show Skill Versions"
      },
      {
        "command": "modelbound.diffSkillVersions",
        "title": "ModelBound: Diff Skill Versions"
      },
      {
        "command": "modelbound.showHealth",
        "title": "ModelBound: Show Project Health"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.84.0",
    "@vscode/vsce": "^3.1.0",
    "typescript": "^5.5.0"
  }
}
