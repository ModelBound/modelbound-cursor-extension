{
  "name": "modelbound-cursor-extension",
  "displayName": "ModelBound — AI Context, Skills & MCP Sync for Cursor",
  "icon": "logo_modelbound.png",
  "description": "Sync AI system prompts, skills, rules, and knowledge bases between your IDE and ModelBound.co. Built-in MCP server exposes 40+ tools to Cursor, Claude, and Copilot.",
  "version": "1.3.0",
  "publisher": "ModelBound",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ModelBound/modelbound-cursor-extension.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "ModelBound Configuration",
      "properties": {
        "modelbound.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your ModelBound.co Secret API Key."
        },
        "modelbound.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, changes to context files (.modelbound, .kiro/skills, .cursor/rules, .claude) automatically sync to ModelBound."
        },
        "modelbound.mcpUrl": {
          "type": "string",
          "default": "https://mcp.modelbound.co/mcp",
          "description": "ModelBound MCP Streamable HTTP endpoint."
        }
      }
    },
    "commands": [
      {
        "command": "modelbound.pullSkill",
        "title": "ModelBound: Pull Skill/Context to Local Workspace"
      },
      {
        "command": "modelbound.setApiKey",
        "title": "ModelBound: Set API Key"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
