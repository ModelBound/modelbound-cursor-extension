{
  "name": "modelbound-cursor-extension",
  "displayName": "ModelBound — AI Context, Skills & MCP Sync for Cursor",
  "icon": "logo_modelbound.png",
  "description": "Cursor rules sync, .cursorrules manager, and system prompt version control. Sync AI skills, rules, and knowledge bases between your IDE and ModelBound.co via MCP. Works with Cursor, Claude Code, Kiro, and Copilot.",
  "version": "1.9.20",
  "publisher": "ModelBound",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ModelBound/modelbound-cursor-extension.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "cursor rules",
    "cursorrules",
    "MCP",
    "system prompt",
    "AI context",
    "Claude skills",
    "prompt version control",
    "cursor rules sync",
    "MCP server",
    "AI rules manager",
    "skill pipeline",
    "CI/CD for prompts",
    "agent CI"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "ModelBound Configuration",
      "properties": {
        "modelbound.apiKey": {
          "type": "string",
          "default": "",
          "description": "Your ModelBound.co Secret API Key."
        },
        "modelbound.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, changes to context files (.modelbound, .kiro/skills, .cursor/rules, .claude) automatically sync to ModelBound."
        },
        "modelbound.syncOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "When opening a watched skill file, check ModelBound for newer cloud content or sync conflicts."
        },
        "modelbound.mcpUrl": {
          "type": "string",
          "default": "https://mcp.modelbound.co",
          "description": "ModelBound MCP Streamable HTTP endpoint."
        },
        "modelbound.authUrl": {
          "type": "string",
          "default": "https://modelbound.co/api/extension-device-auth",
          "description": "ModelBound device authorization endpoint (advanced — usually leave default)."
        },
        "modelbound.apiUrl": {
          "type": "string",
          "default": "https://modelbound.co",
          "description": "ModelBound REST API base URL (advanced)."
        },
        "modelbound.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show Optimize / Pipeline / Versions CodeLens above skill files."
        },
        "modelbound.undoToastSeconds": {
          "type": "number",
          "default": 60,
          "description": "Seconds to show the undo toast after an optimize or restore."
        },
        "modelbound.skillGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional glob patterns to detect skill files (beyond built-in heuristics)."
        }
      }
    },
    "commands": [
      {
        "command": "modelbound.signIn",
        "title": "ModelBound: Sign In with Browser"
      },
      {
        "command": "modelbound.signOut",
        "title": "ModelBound: Sign Out"
      },
      {
        "command": "modelbound.pullSkill",
        "title": "ModelBound: Pull Skill/Context to Local Workspace"
      },
      {
        "command": "modelbound.syncCurrentFile",
        "title": "ModelBound: Sync Current File"
      },
      {
        "command": "modelbound.setApiKey",
        "title": "ModelBound: Set API Key (Manual)"
      },
      {
        "command": "modelbound.runSkillPipeline",
        "title": "ModelBound: Run Skill Development Pipeline"
      },
      {
        "command": "modelbound.browseResourceTree",
        "title": "ModelBound: Browse Resource Tree"
      },
      {
        "command": "modelbound.filterSkills",
        "title": "ModelBound: Filter Skills…"
      },
      {
        "command": "modelbound.runSkillTest",
        "title": "ModelBound: Run Skill Test"
      },
      {
        "command": "modelbound.openTestOptimize",
        "title": "ModelBound: Test & Optimize Panel"
      },
      {
        "command": "modelbound.showSkillFindings",
        "title": "ModelBound: Trust & Safety Findings"
      },
      {
        "command": "modelbound.setPipelineConfig",
        "title": "ModelBound: Configure Pipeline Gates"
      },
      {
        "command": "modelbound.createEvalCase",
        "title": "ModelBound: Create Eval Test Case"
      },
      {
        "command": "modelbound.listEvalCases",
        "title": "ModelBound: List Eval Test Cases"
      },
      {
        "command": "modelbound.ignoreSkillFinding",
        "title": "ModelBound: Ignore Skill Finding"
      },
      {
        "command": "modelbound.benchmarkSkill",
        "title": "ModelBound: Benchmark Skill Latency"
      },
      {
        "command": "modelbound.compareSkillVersions",
        "title": "ModelBound: Compare Skill Versions"
      },
      {
        "command": "modelbound.suggestSkillImprovements",
        "title": "ModelBound: Suggest Skill Improvements"
      },
      {
        "command": "modelbound.showSkillVersions",
        "title": "ModelBound: Show Skill Versions"
      },
      {
        "command": "modelbound.diffSkillVersions",
        "title": "ModelBound: Diff Skill Versions"
      },
      {
        "command": "modelbound.showHealth",
        "title": "ModelBound: Show Project Health"
      },
      {
        "command": "modelbound.optimize",
        "title": "ModelBound: Optimize Current Skill"
      },
      {
        "command": "modelbound.benchmark",
        "title": "ModelBound: Benchmark Two Versions"
      },
      {
        "command": "modelbound.restore",
        "title": "ModelBound: Restore Version…"
      },
      {
        "command": "modelbound.diff",
        "title": "ModelBound: Diff Versions…"
      },
      {
        "command": "modelbound.versions",
        "title": "ModelBound: Show Versions"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
